<Project>

  <!--
    Global defaults. Applied to every project under this repository root.
    Per-project overrides belong in the .csproj or a scoped Directory.Build.props.
  -->

  <PropertyGroup Label="Supply chain">
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <UseLockFiles Condition="'$(UseLockFiles)' == ''">true</UseLockFiles>
    <RestorePackagesWithLockFile Condition="'$(UseLockFiles)' == 'true'">true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Label="Framework and language" Condition="'$(PackageType)' != 'Template'">
    <IncludeAtyaGuards Condition="'$(IncludeAtyaGuards)' == ''">__INCLUDE_ATYA_GUARDS__</IncludeAtyaGuards>
    <IncludeAtyaGovernance Condition="'$(IncludeAtyaGovernance)' == ''">__INCLUDE_ATYA_GOVERNANCE__</IncludeAtyaGovernance>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Build quality" Condition="'$(PackageType)' != 'Template'">
    <IsTemplateSourceRepository Condition="'$(IsTemplateSourceRepository)' == '' And Exists('$(MSBuildThisFileDirectory)Atya.Templates.NuGetPackage.csproj')">true</IsTemplateSourceRepository>
    <IsTemplateSourceRepository Condition="'$(IsTemplateSourceRepository)' == ''">false</IsTemplateSourceRepository>
    <RepositoryHasGitDirectory Condition="'$(RepositoryHasGitDirectory)' == '' And Exists('$(MSBuildThisFileDirectory).git')">true</RepositoryHasGitDirectory>
    <RepositoryHasGitDirectory Condition="'$(RepositoryHasGitDirectory)' == ''">false</RepositoryHasGitDirectory>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Strict on shipped code; relaxed on tests/samples so a warning does not block experiments. -->
    <TreatWarningsAsErrors Condition="'$(IsPackable)' == 'true'">true</TreatWarningsAsErrors>
    <NoWarn Condition="'$(IsTemplateSourceRepository)' == 'true'">$(NoWarn);CA1707;SA1300</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Packaging defaults" Condition="'$(PackageType)' != 'Template'">
    <IsPackable>false</IsPackable>
    <Authors>__PACKAGE_AUTHORS__</Authors>
    <Company>__PACKAGE_COMPANY__</Company>
    <Copyright>Copyright (c) __COPYRIGHT_YEAR__ __PACKAGE_AUTHORS__</Copyright>
    <Description>__PACKAGE_DESCRIPTION__</Description>
    <PackageTags>__PACKAGE_TAGS__</PackageTags>
    <RepositoryUrl>__REPOSITORY_URL__</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Deterministic source paths in PDBs / SourceLink metadata. -->
    <EmbedUntrackedSources Condition="'$(RepositoryHasGitDirectory)' == 'true'">true</EmbedUntrackedSources>
    <PublishRepositoryUrl Condition="'$(RepositoryHasGitDirectory)' == 'true'">true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType Condition="'$(IsPackable)' == 'true'">portable</DebugType>
    <DebugSymbols Condition="'$(IsPackable)' == 'true'">true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Label="Repository URL guard" Condition="'$(PackageType)' != 'Template'">
    <!-- The raw template contains an unresolved __ token; SourceLink runs only after rendering. -->
    <RepositoryUrlIsConfigured Condition="'$(RepositoryUrl)' != '' And !$(RepositoryUrl.Contains('__'))">true</RepositoryUrlIsConfigured>
    <RepositoryUrlIsConfigured Condition="'$(RepositoryUrlIsConfigured)' == ''">false</RepositoryUrlIsConfigured>
  </PropertyGroup>

  <PropertyGroup Label="Trim/AOT opt-ins (per-project)" Condition="'$(PackageType)' != 'Template'">
    <!-- Turn these on in a leaf .csproj when the package is AOT/trim-safe. -->
    <!-- <IsTrimmable>true</IsTrimmable> -->
    <!-- <IsAotCompatible>true</IsAotCompatible> -->
  </PropertyGroup>

  <!--#if (!includeAtyaGovernance) -->
  <ItemGroup Label="Default analyzers" Condition="'$(PackageType)' != 'Template' And '$(IncludeAtyaGovernance)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <!--#endif -->

</Project>
