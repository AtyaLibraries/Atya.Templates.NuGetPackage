{
  "$schema": "http://json.schemastore.org/template",
  "author": "Arsen Asulyan",
  "classifications": [
    "Common",
    "Library",
    "Package"
  ],
  "identity": "Atya.Templates.NuGetPackage",
  "name": "Atya NuGet Package",
  "shortName": "atya-nuget",
  "sourceName": "Atya.Templates.NuGetPackage",
  "preferNameDirectory": true,
  "description": "Creates a production-ready .NET package repository with source, tests, samples, benchmarks, central package management, and GitHub CI/release workflows.",
  "primaryOutputs": [
    {
      "path": "Atya.Templates.NuGetPackage.sln"
    }
  ],
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        ".template.variants/**",
        ".claude/**",
        ".tmp",
        ".tmp/**",
        "README.template.md",
        "template-smoke-test.ps1",
        "Atya.Templates.NuGetPackage.csproj",
        "PACKAGE_README.md",
        "icon.png",
        "packages.lock.json",
        ".github/workflows/test-template.yml",
        ".github/workflows/publish-template.yml",
        "Atya.Templates.NuGetPackage.sln",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/artifacts/**",
        ".git",
        ".git/**",
        ".vs",
        ".vs/**",
        ".idea",
        ".idea/**"
      ],
      "modifiers": [
        {
          "condition": "(!includeBenchmarks)",
          "exclude": [
            "benchmarks/**"
          ]
        },
        {
          "condition": "(!includeGitHub)",
          "exclude": [
            ".github/**",
            "bootstrap.ps1"
          ]
        },
        {
          "condition": "(!includeAtyaGuards)",
          "exclude": [
            "tests/Atya.Templates.NuGetPackage.UnitTests/GuardWiringTests.cs"
          ]
        }
      ]
    },
    {
      "source": "./.template.variants/with-benchmarks/",
      "target": "./",
      "modifiers": [
        {
          "condition": "(!includeBenchmarks)",
          "exclude": [
            "**"
          ]
        }
      ]
    },
    {
      "source": "./.template.variants/without-benchmarks/",
      "target": "./",
      "modifiers": [
        {
          "condition": "(includeBenchmarks)",
          "exclude": [
            "**"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "description": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Package description",
      "description": "Description used in README and NuGet metadata.",
      "defaultValue": "A reusable .NET package.",
      "replaces": "__PACKAGE_DESCRIPTION__"
    },
    "authors": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Package authors",
      "description": "Authors used in NuGet metadata and LICENSE.",
      "defaultValue": "Atya",
      "replaces": "__PACKAGE_AUTHORS__"
    },
    "company": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Package company",
      "description": "Company used in assembly and package metadata.",
      "defaultValue": "Atya",
      "replaces": "__PACKAGE_COMPANY__"
    },
    "tags": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Package tags",
      "description": "Semicolon-separated NuGet tags.",
      "defaultValue": "dotnet;atya",
      "replaces": "__PACKAGE_TAGS__"
    },
    "githubOwner": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "GitHub owner",
      "description": "GitHub org or user that hosts the generated repository.",
      "defaultValue": "AtyaLibraries",
      "replaces": "__GITHUB_OWNER__"
    },
    "repo": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Repository URL",
      "description": "Optional repository URL override used in package metadata and SourceLink.",
      "defaultValue": ""
    },
    "defaultRepositoryUrl": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          { "type": "const", "value": "https://github.com" },
          { "type": "ref", "value": "githubOwner" },
          { "type": "ref", "value": "name" }
        ],
        "separator": "/",
        "removeEmptyValues": true
      }
    },
    "repositoryUrl": {
      "type": "generated",
      "generator": "coalesce",
      "replaces": "__REPOSITORY_URL__",
      "parameters": {
        "sourceVariableName": "repo",
        "fallbackVariableName": "defaultRepositoryUrl",
        "defaultValue": ""
      }
    },
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Target framework",
      "description": "Target framework used by source, tests, and samples.",
      "defaultValue": "net10.0",
      "replaces": "net10.0",
      "choices": [
        { "choice": "net10.0", "description": "Target .NET 10." }
      ]
    },
    "multiTarget": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Target all supported .NET versions",
      "description": "Targets net8.0, net9.0, and net10.0 instead of the single framework selection.",
      "defaultValue": "false",
      "replaces": "__MULTI_TARGET__"
    },
    "includeBenchmarks": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Include benchmarks project",
      "description": "Scaffolds a BenchmarkDotNet project under benchmarks/.",
      "defaultValue": "true"
    },
    "includeGitHub": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Include GitHub configuration",
      "description": "Adds .github/ folder with CI/release workflows, Dependabot, and issue templates.",
      "defaultValue": "true"
    },
    "includeAtyaGuards": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Include Atya guards",
      "description": "Adds the Atya.Foundation.Guards runtime dependency and its wiring test.",
      "defaultValue": "false",
      "replaces": "__INCLUDE_ATYA_GUARDS__"
    },
    "includeAtyaGovernance": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Include Atya governance packages",
      "description": "Uses Atya.Governance.CodeQuality and Atya.Governance.Testing instead of the default analyzer packages.",
      "defaultValue": "false",
      "replaces": "__INCLUDE_ATYA_GOVERNANCE__"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Skip post-generation restore",
      "description": "If true, 'dotnet restore' is not run after template generation.",
      "defaultValue": "false"
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "__COPYRIGHT_YEAR__",
      "parameters": {
        "format": "yyyy"
      }
    },
    "PackageProjectGuid": {
      "type": "generated",
      "generator": "guid",
      "replaces": "467BAA01-26E2-4EC3-928C-70A5EAA36811",
      "parameters": { "format": "D" }
    },
    "TestsProjectGuid": {
      "type": "generated",
      "generator": "guid",
      "replaces": "8B6A28EE-7818-4DE7-B3BE-279B436A17F3",
      "parameters": { "format": "D" }
    },
    "SampleProjectGuid": {
      "type": "generated",
      "generator": "guid",
      "replaces": "177A9C18-53A6-459A-CC8D-01608DB20B5E",
      "parameters": { "format": "D" }
    },
    "BenchmarkProjectGuid": {
      "type": "generated",
      "generator": "guid",
      "replaces": "BA188AA0-3305-D033-CE4E-510CB0A17E3D",
      "parameters": { "format": "D" }
    },
    "SolutionGuid": {
      "type": "generated",
      "generator": "guid",
      "replaces": "C4D89AE8-AFEA-4B36-82D9-2BBF683661B0",
      "parameters": { "format": "D" }
    },
    "packageMarkerName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "PackageMarkerName",
      "replaces": "__PACKAGE_MARKER_NAME__"
    }
  },
  "forms": {
    "PackageNameAfterLastDot": {
      "identifier": "replace",
      "pattern": "^.*\\.(?=[^\\.]+$)",
      "replacement": ""
    },
    "NonIdentifierToUnderscore": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "PackageMarkerName": {
      "identifier": "chain",
      "steps": [
        "PackageNameAfterLastDot",
        "NonIdentifierToUnderscore"
      ]
    }
  },
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages",
      "manualInstructions": [
        { "text": "Run 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": false
    }
  ]
}
